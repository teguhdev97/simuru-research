SIMURU_BASE_URL=https://simuru.com/api
SIMURU_API_KEY=
DATABASE_PATH=data/simuru_research.sqlite3
DEFAULT_TOTAL_JOBS=40
DEFAULT_MAX_WORKERS=3

# Create five real QA mailboxes through cPanel UAPI (local laptop only)
QA_MAIL_DOMAIN=teguhharits.com
QA_MAIL_PREFIX=qa
# Optional legacy API-token provisioner. Browser-session mode does not use these.
QA_CPANEL_HOST=
QA_CPANEL_USERNAME=
QA_CPANEL_API_TOKEN=
# Optional shared password for new browser-created QA mailboxes; leave blank for unique random passwords.
QA_MAILBOX_MASTER_PASSWORD=
QA_MAILBOX_QUOTA_MB=50

# IMAP/SMTP values must match the "Connect Devices" settings in cPanel
QA_IMAP_HOST=mail.teguhharits.com
QA_IMAP_PORT=993
QA_SMTP_HOST=mail.teguhharits.com
QA_SMTP_PORT=465

# OTP reader: exact allowed sender addresses/domains only (comma-separated).
# IMAP passwords come from Windows Credential Manager; no cPanel API token is needed.
QA_OTP_ALLOWED_SENDERS=
QA_OTP_SUBJECT_KEYWORDS=verification,verify,otp,code
